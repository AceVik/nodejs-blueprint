{
  "compilerOptions": {
    "composite": true,
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "esModuleInterop": true,
    "strict": true,
    "baseUrl": "./tests",
    "paths": {
      "@tests/*": [
        "*"
      ],
      "@micro/routes": ["../@micro/routes/src/index.ts"],
      "@micro/routes/*": ["../@micro/routes/src/*"]
    },
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "references": [
    { "path": "../@micro/routes" }
  ],
  "include": [
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}