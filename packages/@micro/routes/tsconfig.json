{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "lib": ["ESNext"],
    "useUnknownInCatchVariables": false,
    "noUncheckedIndexedAccess": true,
    "removeComments": true,
    "outDir": "lib",
    "rootDir": "./src",
    "esModuleInterop": true,
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@micro/routes": ["src/index.ts"],
      "@micro/routes/*": ["src/*"]
    }
  },
  "include": [
    "src/**/*",
    "eslint.config.mjs"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
