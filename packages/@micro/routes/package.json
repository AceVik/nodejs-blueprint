{
  "name": "@micro/routes",
  "type": "module",
  "version": "1.0.0",
  "description": "A micro framework to build restful routes.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./core": "./lib/core/index.js",
    "./router": "./lib/router/index.js",
    "./openapi": "./lib/openapi/index.js",
    "./http": "./lib/http/index.js",
    "./http/presets": "./lib/http/presets.js"
  },
  "scripts": {
    "build": "rm -rf lib && tsc",
    "dev": "tsc -w --preserveWatchOutput",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "tsc --noEmit"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "zod": "^4.2.1",
    "@asteasolutions/zod-to-openapi": "^8.2.0",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.56.0"
  },
  "dependencies": {
    "cookie": "^1.1.1",
    "openapi3-ts": "^4.5.0"
  },
  "devDependencies": {
    "@types/cookie": "^1.0.0",
    "@types/node": "^25.0.3",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3"
  }
}