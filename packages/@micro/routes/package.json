{
  "name": "@micro/routes",
  "type": "module",
  "version": "1.0.0",
  "description": "A micro framework to build restful routes.",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "import": "./dist/*/index.js",
      "require": "./dist/*/index.js",
      "types": "./dist/*/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "prepublishOnly": "pnpm build"
  },
  "files": [
    "dist",
    "index.d.ts"
  ],
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsc-alias": "^1.8.11",
    "typescript": "^5.8.2",
    "zod": "^3.24.2"
  },
  "peerDependencies": {
    "zod": "^3.24.2",
    "@anatine/zod-openapi": "^2.2.7",
    "openapi3-ts": "^4.4.0"
  },
  "dependencies": {
    "@anatine/zod-openapi": "^2.2.7",
    "openapi3-ts": "^4.4.0",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.51.0"
  }
}
