{
  "compilerOptions": {
    "composite": true,
    "traceResolution": true,
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true,
    "strict": true,
    "baseUrl": "./src",
    "paths": {
      "@app/*": ["*"],
      "@micro/routes": ["../@micro/routes/src/index.ts"],
      "@micro/routes/*": ["../@micro/routes/src/*"]
    }
  },
  "references": [
    { "path": "../@micro/routes" }
  ],
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}