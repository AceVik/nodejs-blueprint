    "zod": "^3.24.2"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "tsc-alias": "^1.8.11",
    "eslint": "^9.21.0",
    "jest": "^29.7.0",
    "tsx": "^4.19.3",
    "@types/node": "^22.13.9",
    "@types/express": "^5.0.0"
  }
